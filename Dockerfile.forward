FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir 'httpx>=0.27,<1'
COPY copybot/__init__.py copybot/forward_market.py copybot/forward_paper.py copybot/forward_signals.py copybot/perps.py copybot/research_models.py ./copybot/
CMD ["python", "-m", "copybot.forward_paper", "--journal", "/data/forward-paper.sqlite3"]
